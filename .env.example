APP_NAME=AI Career Agent
ENVIRONMENT=development
DATABASE_URL=sqlite:///./career_agent.db
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173
VECTOR_STORE_PATH=./data/vector_store
VECTOR_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTOR_COLLECTION_NAME=approved_jobs
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Optional server-side interviewer TTS. Keep browser to use local browser speech.
# Use edge for a no-key Chinese demo voice; use volcengine after creating a Doubao/Volcengine TTS app.
TTS_PROVIDER=browser
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=tts-1
TTS_VOICE=zh-CN-YunxiNeural
TTS_RESPONSE_FORMAT=mp3
TTS_MAX_CHARS=180

# Doubao / Volcengine TTS 2.0. Enable with TTS_PROVIDER=volcengine or TTS_PROVIDER=doubao.
VOLC_TTS_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_TYPE=
VOLC_TTS_UID=ai-career-agent
VOLC_TTS_V3_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLC_TTS_SAMPLE_RATE=24000
VOLC_TTS_SPEED_RATIO=1.0
VOLC_TTS_VOLUME_RATIO=1.0
VOLC_TTS_PITCH_RATIO=1.0
